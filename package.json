    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "build:json": "rollup --config",
    "build": "npm run build:json && node scripts/build-blog.mjs && npm run generate-sitemap",
    "check:generated": "npm run build && node scripts/check-generated.mjs"
  },
  "devDependencies": {
