    "tool-navigation",
    "json-formatter",
    "jwt-decoder",
    "online-tools",
    "static-site",
    "ai-resources",
    "vanilla-javascript",
    "open-source",
    "non-commercial"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "audit:tools": "node scripts/audit-tools.mjs",
